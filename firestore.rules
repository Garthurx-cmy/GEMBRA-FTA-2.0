rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function active() {
      return signedIn() && (
        profile().get('ativo', false) == true ||
        profile().get('ATIVO', false) == true
      );
    }

    function admin() {
      return active() && (
        profile().get('perfil', '') in [
          'Desenvolvedor/Admin',
          'Administrador',
          'desenvolvedor',
          'admin'
        ] ||
        profile().get('PERFIL', '') in [
          'DESENVOLVEDOR/ADMIN',
          'ADMINISTRADOR',
          'ADMIN'
        ]
      );
    }

    function manager() {
      return active() && (
        profile().get('perfil', '') in ['Gestor', 'gestor'] ||
        profile().get('PERFIL', '') in ['GESTOR']
      );
    }

    function supervisor() {
      return active() && (
        profile().get('perfil', '') in ['Supervisor', 'supervisor'] ||
        profile().get('PERFIL', '') in ['SUPERVISOR']
      );
    }

    function teamLeader() {
      return active() && (
        profile().get('perfil', '') in [
          'Líder de Equipe',
          'Lider de Equipe',
          'lider_equipe',
          'lider'
        ] ||
        profile().get('PERFIL', '') in [
          'LÍDER DE EQUIPE',
          'LIDER DE EQUIPE',
          'LIDER'
        ]
      );
    }

    function visitor() {
      return active() && (
        profile().get('perfil', '') in ['Visitante', 'visitante'] ||
        profile().get('PERFIL', '') in ['VISITANTE']
      );
    }

    function operational() {
      return admin() || manager() || supervisor() || teamLeader();
    }

    match /users/{uid} {
      allow get: if signedIn() && (
        request.auth.uid == uid ||
        admin()
      );

      allow list: if admin();

      allow create: if admin();

      allow update: if admin() || (
        signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'primeiroAcesso',
            'deveAlterarSenha',
            'ultimoLogin',
            'updatedAt'
          ])
      );

      allow delete: if admin() && request.auth.uid != uid;
    }

    match /inspections/{id} {
      allow read: if active();
      allow create: if operational() && !visitor() &&
        (
          !teamLeader() ||
          (request.resource.data.criadoPorUid == request.auth.uid)
        ) &&
        (!('fotosAntes' in request.resource.data) || request.resource.data.fotosAntes.size() <= 3) &&
        (!('fotosDepois' in request.resource.data) || request.resource.data.fotosDepois.size() <= 3);
      allow update: if operational() && !visitor() &&
        (
          admin() || manager() || supervisor() ||
          (teamLeader() && resource.data.criadoPorUid == request.auth.uid && request.resource.data.criadoPorUid == resource.data.criadoPorUid)
        ) &&
        (!('fotosAntes' in request.resource.data) || request.resource.data.fotosAntes.size() <= 3) &&
        (!('fotosDepois' in request.resource.data) || request.resource.data.fotosDepois.size() <= 3);
      allow delete: if admin();
    }

    match /supervisors/{id} {
      allow read: if active();
      allow write: if admin();
    }

    match /areas/{id} {
      allow read: if active();
      allow write: if admin();
    }

    match /contracts/{id} {
      allow read: if active();
      allow write: if admin();
    }

    match /settings/{id} {
      allow read: if active();
      allow write: if admin();
    }

    match /notifications/{id} {
      allow read: if active();
      allow create, update: if active() && !visitor();
      allow delete: if admin();
    }

    match /authorized_emails/{id} {
      allow read: if active();
      allow write: if admin();
    }

    match /deleted_names/{id} {
      allow read: if active();
      allow write: if admin();
    }

    match /auditLogs/{id} {
      allow read: if admin();
      allow create: if active();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
